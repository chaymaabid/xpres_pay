// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  RETAILER
}

enum EscrowState {
  INITIATED
  LOCKED
  DELIVERED
  RELEASED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  NEW_MESSAGE
  TRUST_SCORE_UPDATED
  NEW_CREDIT_OFFER
  CREDIT_OFFER_ACCEPTED
  CREDIT_OFFER_REJECTED
}

enum CreditOfferStatus{
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}
model User {
  id               String        @id @default(uuid())
  keycloakId       String        @unique
  email            String        @unique
  name             String?
  role             UserRole
  stripeAccountId       String?       // Farmer: Express connected account
  stripeCustomerId      String?       // Retailer: Stripe Customer ID
  stripePaymentMethodId String?       // Retailer: Default saved payment method
    

  trustProfile     TrustProfile?
  
  products         Product[]     @relation("UserProducts")

  ordersAsBuyer    Order[]       @relation("BuyerOrders")

  creditsGranted   Credit[]      @relation("Lender")
  creditsReceived  Credit[]      @relation("Borrower")
  notifications Notification[]

  createdAt        DateTime      @default(now())
}
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(NEW_MESSAGE)
  title     String?
  message   String
  url       String?          
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readedAt DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  stockAvailable Int   @default(0)
  images    ProductImage[]
  // Le Seller est le propriétaire du produit
  ownerId     String      
  owner       User        @relation("UserProducts", fields: [ownerId], references: [id])
  
  orderItems  OrderItem[]
}


model Order {
  id              String       @id @default(uuid())
  totalAmount     Decimal      @db.Decimal(10, 2)
  status          String       
  shippingAddress String
  note            String?

  buyerId         String
  buyer           User         @relation("BuyerOrders", fields: [buyerId], references: [id])

  orderItems      OrderItem[]
  transaction     Transaction?
  
  createdAt       DateTime     @default(now())
}
model Transaction {
  id               String             @id @default(uuid())
  orderId          String             @unique
  order            Order              @relation(fields: [orderId], references: [id])
  
  orderAmount      Decimal @default(0)     @db.Decimal(10, 2) 
  platformFee      Decimal @default(0)     @db.Decimal(10, 2)
  totalPaid        Decimal @default(0)     @db.Decimal(10, 2)
  status           EscrowState        @default(INITIATED)         
  ocrConfidence    Float?
  proofOfDelivery  String?            
  paymentIntentId  String?   
  transferId       String?         

  creditId         String?
  credit           Credit?            @relation(fields: [creditId], references: [id])

  ledgerEntries    TransactionLedger[]
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
model TransactionLedger {
  id             String      @id @default(uuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  
  amount         Decimal     @db.Decimal(10, 2)
  previousStatus EscrowState
  currentStatus  EscrowState
  timestamp      DateTime    @default(now())
  actorId        String      
}
model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  
  quantity         Int
  unitPriceAtOrder Decimal @db.Decimal(10, 2)
}

model TrustProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  
  idNumber      String?
  trustScore    Float        @default(10.0)
  isVerified    Boolean      @default(false)
  cinImg        String?      
  faceImg       String?      

  devices       UserDevice[]
  updatedAt     DateTime     @updatedAt
}

model UserDevice {
  id                String       @id @default(uuid())
  trustProfileId    String
  trustProfile      TrustProfile @relation(fields: [trustProfileId], references: [id])
  
  deviceFingerprint String       
  deviceName        String?
  lastUsed          DateTime     @default(now())

  @@unique([trustProfileId, deviceFingerprint])
}
model Credit {
  id              String   @id @default(uuid())

  lenderId       String
  lender         User          @relation("Lender", fields: [lenderId], references: [id])
  
  borrowerId     String
  borrower       User          @relation("Borrower", fields: [borrowerId], references: [id])

  amount          Float
  currency        String   @default("usd")

  status          CreditOfferStatus @default(PENDING)

  paymentIntentId String?
  transferId      String?
  refundId        String?

  cancelledBy     String?   // retailer/admin
  note            String?

  createdAt       DateTime @default(now())
  respondedAt     DateTime?
  updatedAt       DateTime          @updatedAt
  
  transactions   Transaction[]
  
}




model ProductImage {
  id        String   @id @default(uuid())

  url       String

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
model KycSession {
  id          String   @id @default(uuid())
  userId      String   
  status      String   @default("PENDING") 
  mode        String   
  fullName    String?
  idNumber    String?
  deviceFingerprint String?
  cinImage  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}